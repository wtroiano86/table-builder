{
    "name": "table-builder-development",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.preview.config.ts",
        "demo": "vite --config vite.demo.config.ts",
        "demo:screenshots": "playwright test --config playwright.demo.config.ts --project screenshots",
        "build": "vite build --config vite.preview.config.ts",
        "build:demo": "vite build --config vite.demo.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:browser": "playwright test",
        "test:demo": "playwright test --config playwright.demo.config.ts --project demo",
        "check": "npm run typecheck && npm run format:check && npm test && npm run build",
        "format": "prettier --write resources/react tests/react tests/browser 'tests/Demo/*.{ts,tsx,css,html}' '*.ts' package.json tsconfig.json",
        "format:check": "prettier --check resources/react tests/react tests/browser 'tests/Demo/*.{ts,tsx,css,html}' '*.ts' package.json tsconfig.json"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@inertiajs/react": "3.9.1",
        "@playwright/test": "1.64.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "jsdom": "30.1.3",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
